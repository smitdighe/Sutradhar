# --- App ---
APP_ENV=local                          # local | staging | production
APP_PORT=8000                          # port uvicorn binds
APP_BASE_URL=http://localhost:8000     # backend's own public base URL
API_PREFIX=/api/v1                     # prefix every versioned route is mounted under
# Public verification mount on THIS service. Empty => the routes answer at a
# bare /v/{tag_code}, which is the shape printed on the tag.
PUBLIC_PREFIX=
PUBLIC_CACHE_SECONDS=60                # Cache-Control max-age on the public verification payload
# The FRONTEND origin printed into every QR tag: {PUBLIC_BASE_URL}/v/{TAG_CODE}.
# NOT this backend -- a scanned tag must resolve without waking the API.
# At deploy time this MUST be set to the real Vercel origin, e.g. https://sutradhar.vercel.app
PUBLIC_BASE_URL=http://localhost:3000  # frontend origin the QR payload points at
LOG_LEVEL=info                         # debug | info | warning | error
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated browser origins allowed to call the API

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sutradhar:sutradhar_dev@localhost:5432/sutradhar_dev   # async app driver
DATABASE_URL_SYNC=postgresql+psycopg://sutradhar:sutradhar_dev@localhost:5432/sutradhar_dev   # sync driver, Alembic only
TEST_DATABASE_URL=postgresql+asyncpg://sutradhar:sutradhar_dev@localhost:5432/sutradhar_test  # wiped between test runs
DB_POOL_SIZE=5                         # Neon free tier connection ceiling is low
DB_POOL_MAX_OVERFLOW=2                 # extra connections allowed above the pool size

# --- Session tokens ---
JWT_PRIVATE_KEY_PATH=./keys/jwt_access_ed25519       # Ed25519 PKCS#8 PEM, generated by scripts/gen_keys.py
JWT_PUBLIC_KEY_PATH=./keys/jwt_access_ed25519.pub    # Ed25519 SubjectPublicKeyInfo PEM
JWT_ALGORITHM=EdDSA                    # Ed25519 signature algorithm name in the JOSE header
JWT_ISSUER=sutradhar                   # `iss` claim on issued session tokens
JWT_AUDIENCE=sutradhar/api             # session audience
ACCESS_TOKEN_TTL_SECONDS=900           # 15 min
REFRESH_TOKEN_TTL_SECONDS=2592000      # 30 days
REFRESH_COOKIE_NAME=sutradhar_rt       # cookie carrying the refresh token
REFRESH_COOKIE_SECURE=false            # true in production

# --- Pending (OAuth completion) token — SEPARATE from session ---
PENDING_TOKEN_SECRET=replace_with_32_random_bytes_hex   # HS256 secret, NOT the Ed25519 keypair
PENDING_TOKEN_AUDIENCE=sutradhar/pending                # `aud` claim distinguishing pending from session tokens
PENDING_TOKEN_TTL_SECONDS=600          # 10 min, single-use

# --- Password hashing ---
PASSWORD_PEPPER=replace_with_random_string   # server-side secret mixed in before argon2id
ARGON2_TIME_COST=3                     # argon2id iterations
ARGON2_MEMORY_COST_KIB=65536           # argon2id memory in KiB (64 MiB)
ARGON2_PARALLELISM=2                   # argon2id lanes

# --- OAuth (Google is the only supported provider) ---
OAUTH_REDIRECT_BASE_URL=http://localhost:8000   # base the provider redirects back to
OAUTH_STATE_SECRET=replace_with_random_string   # signs the single-use itsdangerous state token
# empty => Google sign-in reports unavailable, never 500
GOOGLE_CLIENT_ID=
# empty => Google sign-in reports unavailable, never 500
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_PATH=/api/v1/auth/oauth/google/callback   # path appended to OAUTH_REDIRECT_BASE_URL
FRONTEND_COMPLETION_URL=http://localhost:3000/auth/complete   # where a pending token is handed to the UI
FRONTEND_POST_LOGIN_URL=http://localhost:3000/dashboard       # landing page after a completed login
FRONTEND_AUTH_ERROR_URL=http://localhost:3000/auth/error      # landing page for a failed auth attempt

# --- Pagination ---
# HMAC key signing opaque keyset cursors; rotating it invalidates outstanding cursors
CURSOR_SECRET=replace_with_32_random_bytes_hex

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true                # master switch for all limiters
RATE_LIMIT_LOGIN_PER_MINUTE=5          # per IP+email
RATE_LIMIT_LOGIN_IP_PER_MINUTE=20      # per IP alone, stops email-spraying
RATE_LIMIT_REGISTER_PER_HOUR=10        # per IP
RATE_LIMIT_REFRESH_PER_MINUTE=30       # per user
RATE_LIMIT_OAUTH_START_PER_MINUTE=10   # per IP
RATE_LIMIT_COMPLETE_PER_MINUTE=5       # per pending-token jti
RATE_LIMIT_SCAN_PER_MINUTE=60          # per IP, public endpoint

# --- Chain ---
CHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/REPLACE   # testnet JSON-RPC endpoint
CHAIN_ID=80002                         # Polygon Amoy
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000   # deployed Sutradhar registry address
CONTRACT_ABI_PATH=./app/chain/abi/Sutradhar.json              # compiled ABI consumed by the chain client
# relayer key, testnet funds ONLY
CHAIN_SIGNER_PRIVATE_KEY=
CHAIN_CONFIRMATIONS=3                  # blocks before PENDING -> CONFIRMED
CHAIN_MAX_FEE_GWEI=100                 # hard cap, refuse to send above this
CHAIN_TX_TIMEOUT_SECONDS=120           # give up waiting on a receipt after this
CHAIN_WRITE_ENABLED=true               # false => outbox fills but never sends
LOCAL_CHAIN_RPC_URL=http://127.0.0.1:8545   # offline demo fallback
ALCHEMY_CU_MONTHLY_BUDGET=300000000    # track usage, back off before ceiling
CHAIN_GAS_BUFFER_PERCENT=20             # estimates are a floor, not a promise
CHAIN_RBF_BUMP_BPS=1250                 # 12.5%, the minimum most nodes accept for a replacement
CHAIN_MAX_RBF_ATTEMPTS=7                # then stop bumping and say so
CHAIN_RPC_MAX_RETRIES=5                 # transient failures only; a send is never blindly resent
CHAIN_RPC_TIMEOUT_SECONDS=20
CHAIN_QUOTA_FLUSH_UNITS=500             # write-behind: no Postgres round trip per RPC call
CHAIN_QUOTA_FLUSH_SECONDS=30

# --- Crypto-shredding / DPDP ---
IDENTITY_HASH_PEPPER=replace_with_random_string   # per-subject salt lives in DB

# --- IPFS / media ---
# empty => pinning reports unavailable, local mirror still works
PINATA_JWT=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs   # gateway prefix for CID retrieval
IPFS_MIRROR_DIR=./media_mirror         # local content-addressed mirror of pinned media
MEDIA_MAX_BYTES=5242880                # 5 MB per file
PINATA_STORAGE_BUDGET_BYTES=1073741824 # 1 GB free-tier cap
PINATA_TIMEOUT_SECONDS=30              # a hung upload must not hold a request open
MEDIA_BLOB_MAX_BYTES=2097152           # 2MB: inline copy for photos, not video
MEDIA_BLOB_BUDGET_BYTES=268435456      # the DB fills before Pinata does, and a full DB refuses every write
PIN_RETRY_POLL_SECONDS=120             # how often PIN_PENDING rows are retried
PIN_MAX_ATTEMPTS=6                     # then PIN_FAILED; the file still resolves from mirror + blob

# --- Scan anomaly thresholds ---
SCAN_ANOMALY_MAX_REGIONS=3             # distinct regions before suspicion
SCAN_ANOMALY_MAX_SCANS=50              # total scans before suspicion
SCAN_ANOMALY_VELOCITY_KM_PER_H=900     # implied travel speed threshold
SCAN_ANOMALY_MAX_DEVICES=5             # distinct device fingerprints in the window below
SCAN_ANOMALY_DEVICE_WINDOW_MINUTES=60  # window the device-diversity signal looks over
SCAN_DEDUPE_WINDOW_SECONDS=60          # same device+place+network inside this => one scan

# --- Workers ---
SCHEDULER_ENABLED=true                 # false => no background jobs are registered
OUTBOX_POLL_SECONDS=5                  # how often to drain the transaction outbox
CONFIRMATION_POLL_SECONDS=15           # how often to re-check pending tx confirmations
INDEXER_POLL_SECONDS=20                # how often to pull new contract events
RECONCILE_CRON=*/30 * * * *            # cron for on-chain vs database reconciliation
OUTBOX_MAX_ATTEMPTS=6                  # then dead-letter
OUTBOX_BATCH_SIZE=10                   # jobs claimed per drain
OUTBOX_LOCK_STALE_SECONDS=600          # a dead worker's claim is reclaimed after this
OUTBOX_BACKOFF_CAP_SECONDS=300         # min(2**attempts, cap), jittered
INDEXER_BLOCK_RANGE=2000               # fixed eth_getLogs window
MERKLE_BATCH_SIZE=1000                 # leaves per Merkle batch
BATCHING_ENABLED=false                 # demo anchors items individually; batching is built and tested

# --- Bootstrap ---
SEED_ADMIN_EMAIL=admin@sutradhar.example.com # first admin; .local is a reserved TLD that EmailStr rejects at login
SEED_ADMIN_PASSWORD=change_me_locally  # rotate immediately outside local dev
